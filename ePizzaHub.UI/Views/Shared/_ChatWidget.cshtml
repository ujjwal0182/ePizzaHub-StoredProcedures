@Html.AntiForgeryToken()

<style>
    #chat-fab { position: fixed; right: 20px; bottom: 20px; z-index: 1050; }
    #chat-panel { position: fixed; right: 20px; bottom: 80px; width: 340px; max-width: calc(100vw - 40px);
                  height: 460px; z-index: 1050; display: none; flex-direction: column;
                  background: #fff; border: 1px solid #ddd; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,.2); }
    #chat-panel.open { display: flex; }
    #chat-head { padding: 10px 14px; background: #d9480f; color: #fff; border-radius: 12px 12px 0 0; font-weight: 500; }
    #chat-log { flex: 1; overflow-y: auto; padding: 10px; }
    .chat-msg { margin: 6px 0; padding: 8px 10px; border-radius: 10px; max-width: 85%; white-space: pre-wrap; }
    .chat-user { background: #ffe8cc; margin-left: auto; }
    .chat-bot  { background: #f1f3f5; }
    #chat-form { display: flex; gap: 6px; padding: 8px; border-top: 1px solid #eee; }
    #chat-input { flex: 1; }
</style>

<button id="chat-fab" class="btn btn-danger rounded-circle" style="width:52px;height:52px" aria-label="Open assistant">Chat</button>

<div id="chat-panel" role="dialog" aria-label="ePizzaHub Assistant">
    <div id="chat-head">ePizzaHub Assistant</div>
    <div id="chat-log">
        <div class="chat-msg chat-bot">Namaste! Main menu dikha sakta hoon, cart me pizza add/remove kar sakta hoon aur aapke orders dikha sakta hoon. Checkout aap khud karenge.</div>
    </div>
    <form id="chat-form">
        <input id="chat-input" class="form-control" maxlength="500" autocomplete="off" placeholder="Kuch poochho..." />
        <button id="chat-send" class="btn btn-danger" type="submit">Send</button>
    </form>
</div>

<script src="~/js/assistant.js" asp-append-version="true"></script>