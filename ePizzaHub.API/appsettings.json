{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "U+fY3J9Fwe+S0QhYwaXqPlR4XZbh7S6HIUj8nXXj5+AQsyUyiGFNhdw/3f1qvIuV",
    "Issuer": "ePizzaAPI",
    "Audience": "ePizzaUI",
    "TokenExpiryInMinutes": 60
  },
  //User Defined Variables
  "Pricing": {
    "TaxRate": 0.05
  },
  "Assistant": {
    "OllamaUrl": "http://localhost:11434",
    "Model": "qwen2.5:7b",
    "McpUrl": "http://localhost:5200/mcp",
    "MaxIterations": 5
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "WithMachineName",
      "WithThreadId",
      "WithExceptionDetails",
      "WithEnvironmentName",
      "FromLogContext"
    ],
    "Properties": {
      "Application": "ePizzaAPI"
    },
    "WriteTo": [
      // Console sink with a custom output template
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{MachineName}|{RequestId}|{SourceContext}] {Message}{NewLine}{Exception}"
        }
      },
      // File sink with rolling files and JSON formatting
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-development-.txt", // proper unc path D:
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{MachineName}|{RequestId}|{SourceContext}] {Message}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
      // Additional sinks can be added here, such as Seq, Elasticsearch, sql server, etc.
    ]
  }
}
